local mainNames = {main=true,client=true,controller=true,manager=true,
    bootstrap=true,core=true,init=true,loader=true,startup=true}
local function isMainScript(name)
    local words = name:gsub("(%u)(%u%l)","%1 %2"):gsub("(%l)(%u)","%1 %2"):lower()
    for word in words:gmatch("[%a]+") do
        if mainNames[word] then return true end
    end
    return false
end
