local function safeName(name)
    local value = tostring(name):gsub('[%c<>:"/\\|?*]',"_"):gsub("[%. ]+$","")
    if value == "" then value = "unnamed" end
    local base = (value:match("^[^.]+") or value):upper()
    if base == "CON" or base == "PRN" or base == "AUX" or base == "NUL" or base:match("^COM%d$") or base:match("^LPT%d$") then
        value = "_" .. value
    end
    return value
end
local function export(options)
    local root = "script/Roblox/dump-" .. tostring(game.PlaceId) .. "-" .. Http:GenerateGUID(false)
    local function mkdir(path)
        if not isfolder(path) then makefolder(path) end
    end
    mkdir("script")
    mkdir("script/Roblox")
    mkdir(root)
    lastFolder = root
    local used = {[root]={["manifest.json"]=true,["_detached"]=true}}
    local folders = {}
    local function reserve(parent,name,extension)
        used[parent] = used[parent] or {}
        local stem = safeName(name)
        local candidate, n = stem .. extension, 1
        while used[parent][candidate:lower()] do
            n = n + 1
            candidate = stem .. "__" .. n .. extension
        end
        used[parent][candidate:lower()] = true
        return parent .. "/" .. candidate
    end
    local function folderFor(obj)
        if obj == game then return root end
        if obj == nil then
            mkdir(root .. "/_detached")
            return root .. "/_detached"
        end
        if folders[obj] then return folders[obj] end
        local path = reserve(folderFor(obj.Parent),obj.Name,"")
        mkdir(path)
        folders[obj] = path
        return path
    end
    local scripts,seen = {},{}
    local function collect(items)
        for _,obj in pairs(items) do
            if typeof(obj) == "Instance" and not seen[obj] then
                seen[obj] = true
                local matches = (options.locals and obj:IsA("LocalScript")) or (options.modules and obj:IsA("ModuleScript"))
                if matches then
                    local ok,path = pcall(function() return obj:GetFullName() end)
                    if ok and (options.filter == "" or path:lower():find(options.filter,1,true)) then
                        table.insert(scripts,obj)
                    end
                end
            end
        end
    end
    collect(getscripts())
    collect(game:GetDescendants())
    if options.loaded and type(getloadedmodules) == "function" then
        local ok,items = pcall(getloadedmodules)
        if ok and type(items) == "table" then collect(items) end
    end
    local manifest = {placeId=game.PlaceId,total=#scripts,state="running",scripts={}}
    local function saveManifest()
        writefile(root .. "/manifest.json",Http:JSONEncode(manifest))
    end
    saveManifest()
    local saved,failed = 0,0
    log("Found " .. #scripts .. " scripts")
    for i,obj in ipairs(scripts) do
        if cancelled then break end
        local entry = {index=i}
        local ok,err = pcall(function()
            entry.originalPath = obj:GetFullName()
            entry.class = obj.ClassName
            if alive then status.Text = string.format("%d/%d  %s",i,#scripts,entry.originalPath) end
            local source = decompile(obj)
            assert(type(source)=="string" and #source>0,"Decompiler returned no source")
            entry.file = reserve(folderFor(obj.Parent),obj.Name,".lua")
            writefile(entry.file,source)
        end)
        entry.saved = ok
        if ok then saved=saved+1 else
            failed=failed+1
            entry.error=tostring(err)
            log("Failed: " .. (entry.originalPath or tostring(i)) .. " | " .. tostring(err))
        end
        table.insert(manifest.scripts,entry)
        manifest.saved,manifest.failed = saved,failed
        saveManifest()
        if alive then
            counts.Text = string.format("Saved: %d\nFailed: %d",saved,failed)
            fill.Size = UDim2.fromScale(i / #scripts,1)
        end
        task.wait()
    end
    manifest.state = cancelled and "stopped" or "completed"
    saveManifest()
    if alive then
        status.Text = string.format("%s | Saved %d | Failed %d",manifest.state,saved,failed)
        if #scripts==0 then fill.Size=UDim2.fromScale(0,1) end
    end
    log("Output: " .. root)
end

dump.Activated:Connect(function()
    if busy then return end
    if #missing>0 then log("Missing API: " .. table.concat(missing,", ")); return end
    if not settings.locals and not settings.modules then log("Select at least one script type"); return end
    busy,cancelled=true,false
    dump.Text="DUMPING..."
    filter.TextEditable=false
    counts.Text="Saved: 0\nFailed: 0"
    fill.Size=UDim2.fromScale(0,1)
    status.Text="Scanning..."
    logs={}
    local options={locals=settings.locals,modules=settings.modules,loaded=settings.loaded,filter=filter.Text:lower()}
    task.spawn(function()
        local ok,err=pcall(export,options)
        busy=false
        if alive then
            dump.Text="DUMP SCRIPTS"
            filter.TextEditable=true
            if not ok then status.Text="Export failed - see log" end
        end
        if not ok then log(tostring(err)) end
    end)
end)
stop.Activated:Connect(function()
