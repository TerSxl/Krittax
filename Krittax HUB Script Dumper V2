local connections={}
local dragging,dragStart,startPos
-- Drag the header; clamp position to keep the title reachable.
frame.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
        if input.Position.Y <= frame.AbsolutePosition.Y + 55 * scale.Scale then
            dragging=true; dragStart=input.Position; startPos=frame.Position
        end
    end
end)
table.insert(connections,UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
        local delta=input.Position-dragStart
        local viewport=gui.AbsoluteSize
        local x=startPos.X.Scale*viewport.X+startPos.X.Offset+delta.X
        local y=startPos.Y.Scale*viewport.Y+startPos.Y.Offset+delta.Y
        x=math.clamp(x,0,math.max(0,viewport.X-frame.AbsoluteSize.X))
        y=math.clamp(y,0,math.max(0,viewport.Y-60*scale.Scale))
        frame.Position=UDim2.fromOffset(x,y)
    end
end))
table.insert(connections,UIS.InputEnded:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=false end
end))
table.insert(connections,UIS.InputBegan:Connect(function(input,processed)
    if not processed and input.KeyCode==Enum.KeyCode.RightShift then gui.Enabled=not gui.Enabled end
end))
close.Activated:Connect(function()
    if busy then
        log("Press STOP and wait before closing; or use '-' to collapse.")
        return
    end
    alive=false
    for _,connection in ipairs(connections) do connection:Disconnect() end
    gui:Destroy()
end)
