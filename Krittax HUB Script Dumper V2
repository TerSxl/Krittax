local function safeName(name)
    local value = tostring(name):gsub('[%c<>:"/\\|?*]',"_"):gsub("[%. ]+$","")
    if value == "" then value = "unnamed" end
    local base = (value:match("^[^.]+") or value):upper()
    if base == "CON" or base == "PRN" or base == "AUX" or base == "NUL" or base:match("^COM%d$") or base:match("^LPT%d$") then
        value = "_" .. value
    end
    return value
end
local function duration(seconds)
    seconds = math.max(0,math.ceil(seconds))
    return string.format("%dm %02ds",math.floor(seconds / 60),seconds % 60)
end
local activeRun
local function updateETA(run, finished)
    if not alive then return end
    local elapsed = duration(os.clock() - run.started)
    local message = "Estimating..."
    if finished then
        message = "--"
    elseif cancelled then
        message = "Stopping..."
    elseif run.expectedFinish then
        local remaining = run.expectedFinish - os.clock()
        message = remaining > 0 and ("~" .. duration(remaining)) or "Recalculating..."
    end
    eta.Text = "ETA: " .. message .. " | Elapsed: " .. elapsed
end
local lastJob
local function contentChecksum(text)
    local a,b=1,0
    for i=1,#text do
        a=(a+text:byte(i))%65521
        b=(b+a)%65521
    end
    return string.format("%.0f",b*65536+a)
end
local function transientError(message)
    local text = tostring(message):lower()
    for _, token in ipairs({"timeout", "timed out", "temporar", "rate limit", "too many requests", "busy", "network", "connection", "empty output"}) do
        if text:find(token,1,true) then return true end
    end
    return false
end
local function checkSource(source)
    if type(source) ~= "string" or not source:find("%S") then
        return false,"empty output","empty_output"
    end
    -- Recognize explicit diagnostic-only output, not arbitrary comments in code.
    local trimmed = source:match("^%s*(.-)%s*$")
    local longComment = trimmed:match("^%-%-%[%[(.*)%]%]$")
    local diagnostic = (longComment or trimmed):gsub("^%-%-%s*", ""):lower():gsub("^%s+","")
    if (longComment or not trimmed:find("\n",1,true)) and
        (diagnostic:match("^decompilation failed") or diagnostic:match("^failed to decompile")
        or diagnostic:match("^decompiler error") or diagnostic:match("^error:")
        or diagnostic:match("^decompiler timed out")) then
        return false,trimmed,"decompiler_output"
    end
    if type(loadstring)=="function" then
        local called, compiled, err = pcall(loadstring,source,"KRITTAX validation")
        if called and type(compiled)=="function" then return true,nil,nil,true end
        if called then return false,tostring(err or "Source cannot be compiled"),"invalid_source" end
        -- Some environments prohibit compilation. Never execute the returned chunk.
    end
    return true,nil,nil,false
end
local function export(options, run, resumeExisting)
    local job = resumeExisting and lastJob or nil
    local function mkdir(path)
        if not isfolder(path) then makefolder(path) end
    end
    if not job then
        local root = "script/Roblox/dump-" .. tostring(game.PlaceId) .. "-" .. Http:GenerateGUID(false)
        mkdir("script")
        mkdir("script/Roblox")
        mkdir(root)
        local used = {[root]={["manifest.json"]=true,["_detached"]=true,["_longpaths"]=true}}
        local folders = {}
        local function reserve(parent,name,extension)
            used[parent] = used[parent] or {}
            local stem = safeName(name)
            -- ASCII filesystem names avoid malformed UTF-8 truncation and path limits.
            stem = stem:gsub("[^%w%._%- ]","_"):sub(1,48):gsub("[%. ]+$","")
            if stem == "" then stem="unnamed" end
            local candidate, n = stem .. extension, 1
            while used[parent][candidate:lower()] do
                n=n+1
                candidate=stem .. "__" .. n .. extension
            end
            used[parent][candidate:lower()]=true
            return parent .. "/" .. candidate
        end
        local function folderFor(obj, depth)
            depth = depth or 0
            if depth>12 then error("Path too deep") end
            if obj==game then return root end
            if obj==nil then mkdir(root .. "/_detached"); return root .. "/_detached" end
            if folders[obj] then return folders[obj] end
            local path=reserve(folderFor(obj.Parent,depth+1),obj.Name,"")
            if #path>170 then error("Path too long") end
            mkdir(path)
            folders[obj]=path
            return path
        end
        local scripts,seen={},{}
        local candidates=0
        local function collect(items)
            for _,obj in pairs(items) do
                if typeof(obj)=="Instance" and not seen[obj] then
                    seen[obj]=true
                    local matches=(options.locals and obj:IsA("LocalScript")) or (options.modules and obj:IsA("ModuleScript"))
                    if matches then
                        local ok,path=pcall(function() return obj:GetFullName() end)
                        if ok and (options.filter=="" or path:lower():find(options.filter,1,true)) then
                            candidates=candidates+1
                            if not options.fast or isMainScript(obj.Name) then
                                table.insert(scripts,{object=obj,originalPath=path,class=obj.ClassName})
                            end
                        end
                    end
                end
            end
        end
        collect(getscripts())
        collect(game:GetDescendants())
        if options.loaded and type(getloadedmodules)=="function" then
            local ok,items=pcall(getloadedmodules)
            if ok and type(items)=="table" then collect(items) end
        end
        table.sort(scripts,function(a,b) return a.originalPath<b.originalPath end)
        local manifest={version=3,placeId=game.PlaceId,total=#scripts,state="running",scripts={},
            mode=options.fast and "fast" or "full",candidates=candidates,skipped=candidates-#scripts,
            resumeScope="Current GUI session; original selection",errors={}}
        for index,item in ipairs(scripts) do
            local entry={index=index,originalPath=item.originalPath,class=item.class,saved=false,attempts=0}
            local ok,path=pcall(function()
                local file=reserve(folderFor(item.object.Parent),item.object.Name,".lua")
                if #file>220 then error("Path too long") end
                return file
            end)
            if not ok then
                mkdir(root .. "/_longpaths")
                path=root .. "/_longpaths/script-" .. index .. ".lua"
                entry.pathFallback=tostring(path)
                entry.pathWarning="Original folder unavailable; using short path"
            end
            entry.file=path
            item.entry=entry
            table.insert(manifest.scripts,entry)
        end
        job={root=root,items=scripts,manifest=manifest}
        lastJob=job
    end
    assert(job,"No session to resume")
    lastFolder=job.root
    local manifest=job.manifest
    manifest.state="running"
    local pending,saved,reused={},0,0
    if resumeExisting and type(readfile)~="function" then
        log("readfile unavailable: saved files cannot be verified; reprocessing selection.")
    end
    -- Resume checks the exact Instance retained in this GUI session, not path alone.
    for _,item in ipairs(job.items) do
        local entry=item.entry
        local keep=false
        if resumeExisting and entry.saved and type(readfile)=="function" then
            local ok,data=pcall(readfile,entry.file)
            keep=ok and type(data)=="string" and #data==entry.bytes
                and contentChecksum(data)==entry.checksum
            if keep and entry.scriptHash and type(getscripthash)=="function" then
                local hashed,current=pcall(getscripthash,item.object)
                keep=hashed and current==entry.scriptHash
            end
        end
        if keep then
            saved=saved+1
            reused=reused+1
        else
            entry.saved=false
            entry.error=nil
            entry.category=nil
            table.insert(pending,item)
        end
    end
    local failed=0
    local dirty,lastFlush=0,os.clock()
    local reportWarned=false
    local function flush(force)
        if not force and dirty<10 and os.clock()-lastFlush<5 then return end
        manifest.saved,manifest.failed,manifest.reused=saved,failed,reused
        local ok,err=pcall(function()
            writefile(job.root .. "/manifest.json",Http:JSONEncode(manifest))
        end)
        if ok then dirty=0;lastFlush=os.clock();reportWarned=false
        elseif not reportWarned then
            reportWarned=true
            log("Report write failed: " .. tostring(err) .. "; Resume remains available in this GUI.")
        end
    end
    run.flush=flush
    run.manifest=manifest
    manifest.errors={}
    flush(true)
    log(string.format("%s: %d queued | %d reused",resumeExisting and "Resume" or manifest.mode,#pending,reused))
    if #job.items==0 then log("No matching scripts. Change Fast Dump or the name filter.") end
    local function updateCounts()
        if alive then counts.Text=string.format("Saved: %d (%d reused)\nFailed: %d\nTotal: %d",saved,reused,failed,#job.items) end
    end
    updateCounts()
    if alive then fill.Size=UDim2.fromScale(#job.items>0 and reused/#job.items or 0,1) end
    local processingStarted=os.clock()
    for index,item in ipairs(pending) do
        if cancelled then break end
        local entry=item.entry
        local source,category,message,syntaxChecked
        if alive then status.Text=string.format("%d/%d  %s",index,#pending,entry.originalPath) end
        for attempt=1,3 do
            entry.attempts=entry.attempts+1
            local ok,result=pcall(decompile,item.object)
            if ok then
                local valid,reason,kind,checked=checkSource(result)
                if valid then source=result;syntaxChecked=checked;break end
                message,category=reason,kind
            else message,category=tostring(result),"decompile" end
            if cancelled or attempt==3 or not transientError(message) then break end
            log("Retry " .. attempt .. "/2: " .. entry.originalPath)
            task.wait(0.5*attempt)
        end
        if source then
            local ok,err=pcall(writefile,entry.file,source)
            if not ok and transientError(err) and not cancelled then
                task.wait(0.5)
                ok,err=pcall(writefile,entry.file,source)
            end
            if ok then
                entry.saved=true
                entry.bytes=#source
                entry.checksum=contentChecksum(source)
                entry.syntaxChecked=syntaxChecked
                entry.error=nil;entry.category=nil
                entry.scriptHash=nil
                if type(getscripthash)=="function" then
                    local hashed,hash=pcall(getscripthash,item.object)
                    if hashed and type(hash)=="string" then entry.scriptHash=hash end
                end
                saved=saved+1
            else message,category=tostring(err),"write_file" end
        end
        if not entry.saved then
            failed=failed+1
            entry.error=tostring(message or "Unknown failure")
            entry.category=category or "unknown"
            manifest.errors[entry.category]=(manifest.errors[entry.category] or 0)+1
            log(entry.category .. ": " .. entry.originalPath .. " | " .. entry.error)
        end
        dirty=dirty+1
        flush(false)
        local average=(os.clock()-processingStarted)/index
        run.expectedFinish=os.clock()+average*(#pending-index)
        updateETA(run,false)
        updateCounts()
        if alive then fill.Size=UDim2.fromScale((reused+index)/#job.items,1) end
        task.wait()
    end
    manifest.state=cancelled and "stopped" or "completed"
    flush(true)
    if alive then status.Text=string.format("%s | Saved %d | Failed %d | Reused %d",manifest.state,saved,failed,reused) end
    log("Output: " .. job.root)
end

local function startExport(resumeExisting)
    if busy then return end
    if resumeExisting and not lastJob then log("No previous run in this GUI session"); return end
    if #missing>0 then log("Missing API: " .. table.concat(missing,", ")); return end
    if not resumeExisting and not settings.locals and not settings.modules then log("Select at least one script type"); return end
    busy,cancelled=true,false
    local run = {started=os.clock()}
    activeRun = run
    updateETA(run, false)
    dump.Text="DUMPING..."
    filter.TextEditable=false
    counts.Text="Saved: 0\nFailed: 0"
    fill.Size=UDim2.fromScale(0,1)
    status.Text="Scanning..."
    logs={}
    local options={locals=settings.locals,modules=settings.modules,loaded=settings.loaded,fast=settings.fast,filter=filter.Text:lower()}
    task.spawn(function()
        while busy and alive and activeRun == run do
            updateETA(run, false)
            task.wait(1)
        end
    end)
    task.spawn(function()
        local ok,err=pcall(export,options,run,resumeExisting)
        if not ok and run.flush then
            run.manifest.state="error"
            pcall(run.flush,true)
        end
        busy=false
        updateETA(run, true)
        if alive then
            dump.Text=settings.fast and "FAST DUMP" or "DUMP SCRIPTS"
            filter.TextEditable=true
            if not ok then status.Text="Export failed - see log" end
        end
        if not ok then log(tostring(err)) end
    end)
end
