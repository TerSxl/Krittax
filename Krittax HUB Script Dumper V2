end)
copy.Activated:Connect(function()
    if not lastFolder then log("Run an export first"); return end
    if type(setclipboard)=="function" then
        local ok,err=pcall(setclipboard,lastFolder)
        log(ok and "Output path copied" or tostring(err))
    else log("Output: " .. lastFolder) end
end)
